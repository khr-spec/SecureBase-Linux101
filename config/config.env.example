# SecureBase 1.2 - Ubuntu Server 26.04 / VirtualBox NAT
# Kun KEY="literal". Ingen shellkode, variabeludvidelse eller inline-kommentarer.
HOSTNAME="securebase-server"
BOOTSTRAP_USER="vboxuser"
ADMIN_USER="secureadmin"
DEVELOPER_USER="developer1"
GUEST_USER="guest1"
PROJECT_DIR="/srv/securebase"
SSH_PUBLIC_KEY_FILE="keys/secureadmin.pub"
# Denne udgave beholder Ubuntu SSH paa guest-port 22 (host-forward: 2222).
SSH_PORT="22"
SSH_ALLOWED_SOURCE="10.0.2.2"
# NOPASSWD gaelder KUN de tre konkrete driftskommandoer. Ingen NOPASSWD: ALL.
ADMIN_SUDO_NOPASSWD="yes"
UPDATE_SYSTEM="yes"
# Sikker standard: bevar eksisterende netvaerk. Saet yes paa din friske lab-VM.
CONFIGURE_NETWORK="no"
INTERFACE="enp0s3"
STATIC_IP="10.0.2.15/24"
GATEWAY="10.0.2.2"
DNS1="10.0.2.3"
DNS2="1.1.1.1"
# try kraever bekraeftelse i konsollen; apply er kun til bevidst automatisk labbrug.
NETWORK_APPLY="try"
DISK_THRESHOLD="85"
MEMORY_THRESHOLD="90"
MONITOR_INTERVAL="5"
LOGROTATE_KEEP="7"
